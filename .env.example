# Copia este archivo como .env y llena los valores reales.
# El .env NUNCA se sube al repo.
#
# Es UN SOLO .env para todo el proyecto, aca en la raiz.
# El backend lo lee con python-dotenv y el frontend con Vite.

# --- Backend ---
DATABASE_URL=postgresql://usuario:clave@localhost:5432/nombre_bd
N8N_WEBHOOK_URL=
# De que direcciones acepta peticiones el backend. Si no esta la del frontend,
# el navegador las bloquea con "CORS policy". Varias van separadas por comas.
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# OJO: en el frontend solo se pueden usar variables que empiecen por VITE_.
# Todo lo que lleve VITE_ queda visible para cualquiera que abra el navegador,
# asi que aca NUNCA van claves ni contraseñas.
VITE_API_URL=http://localhost:8000/api
